/target/
**/*.rs.bk
.DS_Store
.idea/
.vscode/
__pycache__/
*.py[cod]

# Python binding build artifacts
/bindings/python/.venv/
/bindings/python/target/
/bindings/python/dist/
/bindings/python/python/openbnct/_openbnct*.so
*.whl

# Patient, transport, and generated calculation artifacts are never committed
# by default. Public synthetic cases must be deliberately added under
# benchmarks/synthetic/ with a provenance record.
/cases/
/runs/
/outputs/
*.dcm
*.nii
*.nii.gz
*.h5
statepoint.*.h5
summary.h5

# Conformance fixtures are deliberately byte-fixed references, not generated
# outputs — they must remain tracked even when their extensions match the
# generated-artifact rules above.
!conformance/**/*.dcm
!conformance/**/*.nii
!conformance/**/*.nii.gz
!conformance/**/*.h5
crates/openbnct-gui/dist/
